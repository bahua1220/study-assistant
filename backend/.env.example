# All actual provider/model settings are intentionally omitted.
# Configure your own OpenAI-compatible text and vision services locally.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Legacy QWEN_* variable names are retained for API compatibility, not a preset.
QWEN_API_KEY=
QWEN_MODEL=
QWEN_QA_MODEL=
QWEN_VOCAB_MODEL=
QWEN_VOCAB_BASE_URL=
# Optional JSON object of provider-specific vision request fields; empty by default.
VISION_REQUEST_OPTIONS_JSON={}

# Leave blank for an automatically generated local signing secret, or set your own.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost
AI_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16777216
HOST=127.0.0.1
PORT=8003
